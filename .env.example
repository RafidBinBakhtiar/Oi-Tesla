# Copy to .env next to docker-compose.yml. Never commit the real .env.
# Every value has a local default in docker-compose.yml, so `docker compose up`
# works without this file — but set real secrets for anything public.

# Postgres (container)
POSTGRES_USER=oitesla
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oi_tesla

# API
JWT_SECRET=replace-with-a-long-random-string-min-16-chars
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Seed zones and sub-locations on start (idempotent).
SEED_ON_START=true

# Web — the API URL as the *browser* sees it
PUBLIC_API_URL=http://localhost:4000

# Host ports
WEB_PORT=3000
API_PORT=4000
DB_PORT=5433
