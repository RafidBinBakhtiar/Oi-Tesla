# Copy to api/.env for running the API outside Docker (npm run dev).
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://oitesla:oitesla@localhost:5432/oi_tesla
# Integration tests only — must point at a disposable database.
TEST_DATABASE_URL=postgresql://oitesla:oitesla@localhost:5432/oi_tesla_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
